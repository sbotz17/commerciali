rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isSuper() {
      return signedIn()
        && exists(/databases/$(database)/documents/utenti/$(uid()))
        && get(/databases/$(database)/documents/utenti/$(uid())).data.super_admin == true;
    }
    function memberOf(az) {
      return signedIn()
        && az is string
        && exists(/databases/$(database)/documents/membri/$(az + "_" + uid()));
    }
    function isAdminOf(az) {
      return memberOf(az)
        && get(/databases/$(database)/documents/membri/$(az + "_" + uid())).data.ruolo == "admin";
    }
    function canManage(az) {
      return isSuper() || isAdminOf(az);
    }

    // ---------- profili ----------
    match /utenti/{userId} {
      allow read: if signedIn();
      // Il profilo personale non può auto-assegnarsi super_admin.
      allow create: if signedIn()
        && userId == uid()
        && (
          !('super_admin' in request.resource.data)
          || request.resource.data.super_admin == false
        );
      allow update: if isSuper()
        || (
          signedIn()
          && userId == uid()
          && (
            !('super_admin' in request.resource.data)
            || request.resource.data.super_admin == resource.data.super_admin
          )
          && (
            !('ruolo' in request.resource.data)
            || request.resource.data.ruolo == resource.data.ruolo
          )
          && (
            !('attivo' in request.resource.data)
            || request.resource.data.attivo == resource.data.attivo
          )
        );
      allow delete: if isSuper();
    }

    // ---------- aziende ----------
    match /aziende/{az} {
      allow read: if signedIn() && (memberOf(az) || isSuper());
      allow create: if signedIn()
        && request.resource.data.created_by == uid();
      allow update: if canManage(az);
      allow delete: if isSuper();
    }

    // ---------- membri (id = azienda_uid) ----------
    match /membri/{id} {
      allow read: if signedIn() && (
        isSuper()
        || resource.data.utente_id == uid()
        || memberOf(resource.data.azienda_id)
      );
      allow create: if signedIn() && (
        canManage(request.resource.data.azienda_id)
        || (
          request.resource.data.utente_id == uid()
          && get(/databases/$(database)/documents/aziende/$(request.resource.data.azienda_id)).data.created_by == uid()
        )
      );
      allow update, delete: if canManage(resource.data.azienda_id);
    }

    // ---------- collezioni per azienda ----------
    match /prodotti/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id);
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /categorie/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id);
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /clienti/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id);
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /preventivi/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id);
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /giro_visite/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id);
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /impostazioni/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id);
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /contatori/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id);
      allow update: if memberOf(resource.data.azienda_id) || isSuper();
      allow delete: if isSuper();
    }

    // ---------- ruoli e licenze: gestione admin/piattaforma ----------
    match /ruoli/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if isAdminOf(request.resource.data.azienda_id);
      allow update, delete: if isAdminOf(resource.data.azienda_id) || isSuper();
    }
    match /licenze/{az} {
      allow read: if memberOf(az) || isSuper();
      allow create: if isSuper() || (
        signedIn()
        && get(/databases/$(database)/documents/aziende/$(az)).data.created_by == uid()
        && request.resource.data.piano == "trial"
      );
      allow update, delete: if isSuper();
    }

    // ---------- agenda, notifiche e chat ----------
    function partecipanteStanza(stanzaId) {
      return memberOf(get(/databases/$(database)/documents/chat_stanze/$(stanzaId)).data.azienda_id)
        && uid() in get(/databases/$(database)/documents/chat_stanze/$(stanzaId)).data.partecipanti_uids;
    }

    match /appuntamenti/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id) || isSuper();
      allow update: if memberOf(resource.data.azienda_id) && (
        resource.data.privato != true
        || resource.data.created_by == uid()
        || resource.data.operatore_id == uid()
        || (
          resource.data.invitati_uids is list
          && uid() in resource.data.invitati_uids
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['conferme', 'stato_condivisione', 'updated_at'])
        )
      ) || isSuper();
      allow delete: if memberOf(resource.data.azienda_id) && (
        resource.data.privato != true
        || resource.data.created_by == uid()
        || resource.data.operatore_id == uid()
      ) || isSuper();

      // Dettagli riservati degli appuntamenti privati: solo creatore,
      // operatore e super admin. Gli altri membri vedono solo la fascia
      // occupata nel documento principale redatto.
      match /privato/{doc} {
        allow read, write: if signedIn()
          && memberOf(get(/databases/$(database)/documents/appuntamenti/$(id)).data.azienda_id)
          && (
            get(/databases/$(database)/documents/appuntamenti/$(id)).data.created_by == uid()
            || get(/databases/$(database)/documents/appuntamenti/$(id)).data.operatore_id == uid()
            || isSuper()
          );
      }
    }
    match /task/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id) || isSuper();
      allow update: if memberOf(resource.data.azienda_id) || isSuper();
      allow delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /promemoria/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id) || isSuper();
      allow update: if memberOf(resource.data.azienda_id) || isSuper();
      allow delete: if memberOf(resource.data.azienda_id) || isSuper();
    }

    match /notifiche/{id} {
      allow read, delete: if signedIn() && resource.data.utente_uid == uid();
      allow create: if memberOf(request.resource.data.azienda_id)
        && request.resource.data.mittente_uid == uid()
        && exists(/databases/$(database)/documents/membri/$(request.resource.data.azienda_id + "_" + request.resource.data.utente_uid));
      allow update: if signedIn()
        && resource.data.utente_uid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['letta_at']);
    }
    match /dispositivi/{id} {
      allow read, delete: if signedIn() && resource.data.utente_uid == uid();
      allow create: if signedIn() && request.resource.data.utente_uid == uid();
      allow update: if signedIn()
        && resource.data.utente_uid == uid()
        && request.resource.data.utente_uid == uid();
    }
    match /impostazioni_notifiche/{id} {
      // `resource == null` copre il primo accesso: il documento non esiste
      // ancora e senza questa condizione Firestore risponde `permission-denied`
      // anche se l'utente sta leggendo solo le proprie preferenze. Il controllo
      // sul suffisso `_<uid>` evita di rivelare l'esistenza delle preferenze
      // di altri utenti.
      allow read: if signedIn() && (
        (resource == null && id.matches('.*_' + uid()))
        || resource.data.utente_uid == uid() || isSuper());
      allow create: if signedIn() && request.resource.data.utente_uid == uid();
      allow update: if signedIn() && resource.data.utente_uid == uid();
      allow delete: if signedIn() && resource.data.utente_uid == uid();
    }

    // Rubrica aziendale dei recapiti per le notifiche WhatsApp. Contiene solo
    // numero e consenso, mai token o segreti; è leggibile dai membri
    // dell'azienda per inviare avvisi ai colleghi.
    match /contatti_notifiche/{id} {
      allow read: if signedIn() && memberOf(resource.data.azienda_id);
      allow create: if signedIn()
        && request.resource.data.azienda_id is string
        && request.resource.data.utente_uid == uid()
        && memberOf(request.resource.data.azienda_id);
      allow update: if signedIn()
        && resource.data.utente_uid == uid()
        && request.resource.data.utente_uid == uid()
        && request.resource.data.azienda_id == resource.data.azienda_id
        && memberOf(resource.data.azienda_id);
      allow delete: if signedIn() && resource.data.utente_uid == uid();
    }

    match /allegati/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id) || isSuper();
      allow update: if memberOf(resource.data.azienda_id) || isSuper();
      allow delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /impostazioni_agenda/{az} {
      allow read: if memberOf(az) || isSuper();
      allow create, update, delete: if isAdminOf(az) || isSuper();
    }
    match /integrazioni_azienda/{az} {
      allow read: if isAdminOf(az) || isSuper();
      allow create, update: if (isAdminOf(az) || isSuper())
        && request.resource.data.azienda_id == az
        && !request.resource.data.keys().hasAny(['client_secret', 'token', 'refresh_token', 'password']);
      allow delete: if isAdminOf(az) || isSuper();
    }
    match /condivisioni_calendario/{id} {
      allow read: if signedIn()
        && memberOf(resource.data.azienda_id)
        && (resource.data.proprietario_uid == uid()
            || (resource.data.destinatario_uid == uid()
                && resource.data.stato == 'attiva')
            || isAdminOf(resource.data.azienda_id)
            || isSuper());
      allow create: if signedIn()
        && memberOf(request.resource.data.azienda_id)
        && request.resource.data.proprietario_uid == uid()
        && request.resource.data.destinatario_uid != uid()
        && request.resource.data.livello in ['libero_occupato', 'dettagli', 'modifica']
        && request.resource.data.stato == 'attiva'
        && exists(/databases/$(database)/documents/membri/$(request.resource.data.azienda_id + "_" + request.resource.data.destinatario_uid))
        && id == request.resource.data.azienda_id + "_" + request.resource.data.proprietario_uid + "_" + request.resource.data.destinatario_uid;
      allow update: if signedIn()
        && (resource.data.proprietario_uid == uid()
            || isAdminOf(resource.data.azienda_id)
            || isSuper())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'revoked_at', 'revoked_by', 'updated_at']);
      allow delete: if signedIn()
        && (resource.data.proprietario_uid == uid()
            || isAdminOf(resource.data.azienda_id)
            || isSuper());
    }
    match /integrazioni/{id} {
      allow read: if signedIn() && (resource.data.utente_uid == uid() || isSuper());
      allow write: if false;
    }
    match /slot/{token} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id) || isSuper();
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /prenotazioni/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow create: if memberOf(request.resource.data.azienda_id) || isSuper();
      allow update, delete: if memberOf(resource.data.azienda_id) || isSuper();
    }
    match /cache_eventi_esterni/{id} {
      allow read: if memberOf(resource.data.azienda_id) || isSuper();
      allow write: if false;
    }
    match /chat_stanze/{stanzaId} {
      allow read, update: if memberOf(resource.data.azienda_id)
        && uid() in resource.data.partecipanti_uids;
      allow create: if memberOf(request.resource.data.azienda_id)
        && uid() in request.resource.data.partecipanti_uids;
      allow delete: if signedIn() && (resource.data.creatore_uid == uid() || isSuper());
    }
    match /chat_stanze/{stanzaId}/messaggi/{msgId} {
      allow read: if partecipanteStanza(stanzaId);
      allow create: if partecipanteStanza(stanzaId)
        && request.resource.data.mittente_uid == uid();
      allow update, delete: if signedIn() && (resource.data.mittente_uid == uid() || isSuper());
    }
    match /chat_stanze/{stanzaId}/letture/{utenteId} {
      allow read, write: if partecipanteStanza(stanzaId)
        && (utenteId == uid() || isSuper());
    }

    // ---------- configurazioni di piattaforma ----------
    match /piani_config/{id} {
      allow read: if signedIn();
      allow write: if isSuper();
    }
    match /whatsapp_config/{id} {
      allow read, write: if isSuper();
    }
    // I bandi sono dati pubblici: la lettura non richiede login.
    match /bandi_fonti/{id} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /bandi_incentivi/{id} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /bandi_sync_log/{id} {
      allow read: if true;
      allow write: if isSuper();
    }

    // Accesso con Face ID: solo le Cloud Functions (Admin SDK) leggono e
    // scrivono queste collezioni. Nessun accesso diretto dall'app.
    match /_passkey_sfide/{id} {
      allow read, write: if false;
    }
    match /_passkey_credenziali/{id} {
      allow read, write: if false;
    }
    match /_passkey_limiti/{id} {
      allow read, write: if false;
    }
  }
}
