# Copia questo file in ".env" e compila i valori.

# Porta su cui gira il server (dietro il reverse proxy https)
PORT=3000

# Chiave segreta: DEVE coincidere con l'"API key" impostata nella console
# Super Admin → WhatsApp dell'app. Generane una lunga e casuale.
API_KEY=cambia-questa-con-una-chiave-lunga-e-casuale

# Origine consentita per le chiamate dal browser (l'URL dell'app).
# Es: https://sbotz17.github.io  — oppure * per consentire tutte (sconsigliato)
ALLOWED_ORIGIN=*

# Cartella dove salvare la sessione WhatsApp (non cancellarla: evita di
# riscansionare il QR ad ogni riavvio)
AUTH_DIR=./auth

# ------------------------------------------------------------
# PROMEMORIA GIRO VISITE (opzionale)
# ------------------------------------------------------------
# Servono per far inviare al server i promemoria automatici delle visite.
# Trovi entrambi in Supabase → Project Settings → API.
# ATTENZIONE: la service_role key ha pieni poteri sul database: tienila solo
# qui sul server, non metterla MAI nell'app o nel repository.
# Se lasci vuoti questi valori, lo scheduler resta spento (il resto funziona).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Ogni quanti millisecondi controllare i promemoria da inviare (default 60000 = 1 min)
PROMEMORIA_POLL_MS=60000
